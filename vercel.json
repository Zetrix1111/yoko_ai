{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/**/*.py": { "maxDuration": 60 },
    "api/chat.py":     { "maxDuration": 300 },
    "api/facturas.py": { "maxDuration": 300 }
  }
}
