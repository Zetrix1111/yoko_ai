# Token Personal Access (igual que Yoko)
AIRTABLE_TOKEN=pat...

# ID de la base "Tablas CMEJIA SAC" (donde viven todas las tablas: productos,
# wa_sessions, conversaciones, mensajes, outbox)
AIRTABLE_BASE_ID=app9s5KuEvlAlZJgl

# URL base de Yoko en Vercel — el bot llama a /api/sales_chat
YOKO_BASE_URL=https://yokochat.vercel.app

# Logs: 'silent' (default Baileys), 'info', 'debug'
LOG_LEVEL=silent
