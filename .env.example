# ──────────────────────────────────────────────
# Variables PRIVADAS del SERVIDOR
# (nunca se exponen al browser — sin prefijo VITE_)
# ──────────────────────────────────────────────

# Airtable — única base que usa la app (Empleados, Empresas, Config_Empresa,
# Config_Ventas, productos, wa_sessions, conversaciones, mensajes, outbox,
# solicitudes_caja, etc. — todo en la misma base).
AIRTABLE_TOKEN=pat...      # Personal Access Token de Airtable
AIRTABLE_BASE_ID=app...    # ID de la base (empieza con "app")

# Make.com — webhooks del módulo "Facturas Inteligentes"
# Si están vacíos, los endpoints devuelven datos mock (modo desarrollo).
MAKE_WEBHOOK_FACTURAS_PROCESAR=https://hook.us2.make.com/...
MAKE_WEBHOOK_FACTURAS_CONCAR=https://hook.us2.make.com/...

# OpenAI — transcripción de audio (gpt-4o-mini-transcribe) +
# chat conversacional Yoko (api/chat.py) y agente de ventas (api/_ventas/chat.py).
OPENAI_API_KEY=sk-...

# Multi-tenant: la identidad del cliente NO viene de env vars.
# - Backend: viene del JWT (claim `empresa_id`), validado en cada request.
# - Frontend: viene de la sesión activa (localStorage tras login), no del bundle.
# Para dar de alta un cliente nuevo: crear filas en Airtable (tabla Empresas
# + un usuario en Empleados con email/password_hash) — no hay que tocar el repo.

# JWT — secreto para firmar/verificar tokens de sesión (HS256, TTL 30 días)
JWT_SECRET=cambia-esto-en-produccion

# ──────────────────────────────────────────────
# Anthropic Managed Agents (chat web — Etapa A en adelante)
# Mientras YOKO_BACKEND=openai estas pueden quedar vacías.
# Cuando se prenda YOKO_BACKEND=managed_agents pasan a ser obligatorias.
# ──────────────────────────────────────────────

# API key de Anthropic (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-...

# Agent ya creado en platform.claude.com (Yoko — Asistente Empresarial)
YOKO_AGENT_ID=agent_...

# Environment yoko-prod (Python 3.11, networking limited)
YOKO_ENVIRONMENT_ID=env_...

# Vault y Memory Store por empresa.
# A medida que se sume cada cliente nuevo se agrega su par aquí.
YOKO_VAULT_ID_CMEJIA=vlt_...
YOKO_MEMORY_STORE_ID_CMEJIA=mem_...

# Feature flag de orquestación.
#   openai          -> flujo legacy (api/_yoko/handler.py + OpenAI tool-calling)
#   managed_agents  -> flujo nuevo  (api/_yoko/handler_managed.py — se crea en Etapa F)
# Default: openai. Se prende a managed_agents recién al final de Etapa F.
YOKO_BACKEND=openai

# Vercel KV (Upstash REST). Se inyectan SOLAS al activar la integración en Vercel —
# documentadas acá solo como referencia, no se ponen a mano en local.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ──────────────────────────────────────────────
# Frontend (Vite) — TIENE QUE coincidir con YOKO_BACKEND del backend.
# Si difiere, los archivos se procesan dos veces (parse_file + skill) o
# el frontend manda attachments base64 que el handler legacy ignora.
#   openai          -> useChat.js usa parse_file y manda historial completo
#   managed_agents  -> useChat.js codifica archivos a base64 y manda solo
#                      el último mensaje (Anthropic persiste el historial)
# ──────────────────────────────────────────────
VITE_YOKO_BACKEND=openai
