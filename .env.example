# ──────────────────────────────────────────────
# Variables PRIVADAS del SERVIDOR
# (nunca se exponen al browser — sin prefijo VITE_)
# ──────────────────────────────────────────────

# Airtable — login directo
AIRTABLE_TOKEN=pat...           # Personal Access Token de Airtable
AIRTABLE_BASE_ID=app...         # ID de la base (empieza con "app")
AIRTABLE_TABLE=Empleados        # Nombre exacto de la tabla

# Make.com — webhooks internos
MAKE_WEBHOOK_AI=https://hook.us2.make.com/...
MAKE_WEBHOOK_UPLOAD=https://hook.us2.make.com/...

# Make.com — webhooks del módulo "Facturas Inteligentes"
# Si están vacíos, los endpoints devuelven datos mock (modo desarrollo)
MAKE_WEBHOOK_FACTURAS_PROCESAR=https://hook.us2.make.com/...
MAKE_WEBHOOK_FACTURAS_CONCAR=https://hook.us2.make.com/...

# Canal de la app
CHANNEL=app_cmejia

# OpenAI — transcripción de audio + chat conversacional con IA
# Transcripción: gpt-4o-mini-transcribe (api/transcribe.py)
# Chat: gpt-4.1-mini-2025-04-14 con function calling (api/chat.py)
OPENAI_API_KEY=sk-...

# Multi-tenant BACKEND: id del cliente cuya config dinámica se carga desde
# Airtable (Config_Procesos, Aprobadores, Centros_Costo, Tipos_Gasto).
# El estático lo lee desde src/tenants/<TENANT_ID>/config.json.
# Si falta, cae al fallback "cmejia" (con warning).
TENANT_ID=cmejia

# ──────────────────────────────────────────────
# Variables PÚBLICAS del CLIENTE
# Llevan prefijo VITE_ porque se inyectan en el bundle del browser
# ──────────────────────────────────────────────

# Multi-tenant: id del cliente cuya config se carga (src/tenants/<id>/config.json)
# Si no se setea o el id no existe, cae al fallback "cmejia"
VITE_TENANT_ID=cmejia
