# ──────────────────────────────────────────────
# Variables PRIVADAS del SERVIDOR
# (nunca se exponen al browser — sin prefijo VITE_)
# ──────────────────────────────────────────────

# Airtable — única base que usa la app (Empleados, Empresas, Config_Empresa,
# Config_Ventas, productos, wa_sessions, conversaciones, mensajes, outbox,
# solicitudes_caja, etc. — todo en la misma base).
AIRTABLE_TOKEN=pat...      # Personal Access Token de Airtable
AIRTABLE_BASE_ID=app...    # ID de la base (empieza con "app")

# Make.com — webhooks del módulo "Facturas Inteligentes"
# Si están vacíos, los endpoints devuelven datos mock (modo desarrollo).
MAKE_WEBHOOK_FACTURAS_PROCESAR=https://hook.us2.make.com/...
MAKE_WEBHOOK_FACTURAS_CONCAR=https://hook.us2.make.com/...

# OpenAI — transcripción de audio (gpt-4o-mini-transcribe) +
# chat conversacional Yoko (api/chat.py) y agente de ventas (api/_ventas/chat.py).
OPENAI_API_KEY=sk-...

# Multi-tenant: la identidad del cliente NO viene de env vars.
# - Backend: viene del JWT (claim `empresa_id`), validado en cada request.
# - Frontend: viene de la sesión activa (localStorage tras login), no del bundle.
# Para dar de alta un cliente nuevo: crear filas en Airtable (tabla Empresas
# + un usuario en Empleados con email/password_hash) — no hay que tocar el repo.

# JWT — secreto para firmar/verificar tokens de sesión (HS256, TTL 30 días)
JWT_SECRET=cambia-esto-en-produccion
